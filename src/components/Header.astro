---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Accueil" },
  { href: "/blog", label: "Blog" },
  { href: "/a-propos", label: "À propos" },
  { href: "/contact", label: "Contact", cta: true },
];
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Accueil">
      <span class="logo-title">
        <svg width="20" height="20" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:inline-block;vertical-align:middle;margin-right:6px;">
          <circle cx="16" cy="16" r="15" fill="rgba(27,124,119,0.1)" stroke="rgba(27,124,119,0.35)" stroke-width="1.5"/>
          <path d="M7 14 Q11.5 9.5 16 14 T25 14" stroke="#1b7c77" stroke-width="2" fill="none" stroke-linecap="round"/>
          <path d="M7 20 Q11.5 15.5 16 20 T25 20" stroke="#1b7c77" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.55"/>
        </svg>
        Lagon Web
      </span>
      <span class="logo-subtitle">SEO · IA · GEO & LLM — depuis le Québec</span>
    </a>
    <nav class="main-nav" aria-label="Navigation principale">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            "nav-link",
            { active: currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)) },
            { cta: link.cta }
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
