---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Accueil" },
  { href: "/blog", label: "Blog" },
  { href: "/a-propos", label: "À propos" },
  { href: "/contact", label: "Contact", cta: true },
];
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Accueil">
      <img src="/images/logo-lagon-web.png" alt="Lagon Web" class="logo-img" width="128" height="45" />
      <span class="logo-subtitle">SEO · IA · GEO & LLM — depuis le Québec</span>
    </a>
    <nav class="main-nav" aria-label="Navigation principale">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            "nav-link",
            { active: currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)) },
            { cta: link.cta }
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
